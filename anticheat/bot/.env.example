# ---------------- Discord ----------------
# Token do bot (https://discord.com/developers/applications -> Bot -> Reset Token)
DISCORD_TOKEN=coloque_o_token_do_bot
# ID do servidor do Discord (registra os comandos na hora). Vazio = comandos globais (demoram até 1h).
DISCORD_GUILD_ID=
# IDs dos "super donos" (podem adicionar/remover outros donos). Separe por vírgula.
# O dono do servidor do Discord também é super dono automaticamente.
AC_OWNER_IDS=111111111111111111
# (opcional) cargos que podem usar /ac além dos donos. Separe por vírgula.
AC_ROLE_IDS=
# (opcional) canal inicial de logs (pode ser trocado com /ac logs)
AC_LOG_CHANNEL_ID=

# ---------------- API (servidor SA-MP/open.mp -> bot) ----------------
AC_API_HOST=0.0.0.0
AC_API_PORT=8090
# Mesma chave do DCAC_API_KEY no gamemode. Mínimo 16 caracteres, apenas letras, números, _ e -
AC_API_KEY=troque_esta_chave_super_secreta
# (opcional) IPs autorizados a falar com a API (ex.: IP da sua VPS do SA-MP). Vazio = qualquer IP com a chave.
AC_ALLOWED_IPS=127.0.0.1

# (opcional) pasta onde a configuração e o histórico ficam salvos
AC_DATA_DIR=
