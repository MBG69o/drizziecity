# ---------------- Discord ----------------
# Token do bot (https://discord.com/developers/applications -> Bot -> Reset Token)
DISCORD_TOKEN=coloque_o_token_do_bot
# OBRIGATÓRIO: ID do Discord do projeto. O bot só funciona nele e sai de qualquer outro Discord.
DISCORD_GUILD_ID=
# canal da equipe que recebe os alertas de TODOS os servidores (deixe vazio para desligar)
AC_ALERT_CHANNEL_ID=1569638075166892072
# (opcional) administradores do BOT: acesso total a todos os servidores (suporte). Separe por vírgula.
AC_BOT_ADMIN_IDS=
# URL pública do bot (para o painel web /ac painelweb e o selo /ac selo). Ex.: https://eagleeye.discloud.dev
AC_PUBLIC_URL=

# ---------------- API (servidores SA-MP/open.mp -> bot) ----------------
AC_API_HOST=0.0.0.0
# porta da API. Na Discloud (site) use 8080.
AC_API_PORT=8090
# atrás de proxy (Discloud/Cloudflare/Nginx): lê o IP real em cf-connecting-ip/X-Forwarded-For.
# JÁ VEM LIGADO (true). Deixe assim na Discloud! Só coloque false se rodar SEM proxy (direto).
# Se ficar errado, todos os servidores viram "o mesmo IP" e dão flapping e erro de "não conectou".
AC_TRUST_PROXY=true
# (opcional) IPs autorizados a falar com a API. Vazio = qualquer IP (cada servidor usa o próprio token).
AC_ALLOWED_IPS=
# (recomendado) OCULTAR os endpoints dos servidores de jogo:
#  AC_PATH_SECRET: prefixo secreto no caminho. Ex.: x7f3k9q2 -> endpoints viram /x7f3k9q2/ac/config
#                  Sem o segredo, a raiz e os caminhos padrão respondem "OK"/404 sem revelar nada.
#  AC_APP_KEY:     chave de aplicação enviada em &k=; requisição sem ela recebe 404.
# Defina os MESMOS valores no include (EE_API_PATH/EE_API_KEY) ou no plugin (api_path/api_key do obfuscate).
AC_PATH_SECRET=
AC_APP_KEY=

# (opcional) pasta onde as configurações e o histórico ficam salvos
AC_DATA_DIR=

# (opcional) fuso horário do resumo diário
AC_TIMEZONE=America/Sao_Paulo

# (opcional) de quantos em quantos segundos o status do bot troca (mínimo 15)
AC_STATUS_INTERVAL=30

# ---------------- Proteção da API (anti-DDoS de aplicação) ----------------
# requisições por minuto por IP (um servidor do jogo usa ~6-20/min)
AC_RATE_LIMIT=120
# pico permitido de uma vez por IP
AC_RATE_BURST=60
# conexões simultâneas máximas na API
AC_MAX_CONNECTIONS=1000

# ---------------- Licenças (versão em plugin) ----------------
# Defina os dois para ligar o licenciamento. Devem ser iguais no secrets.json do plugin.
# Gere com: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
AC_LICENSE_PEPPER=
AC_LICENSE_SIGN=
# true = servidores sem licença ativa não recebem configuração (produto 100% licenciado)
AC_REQUIRE_LICENSE=false
